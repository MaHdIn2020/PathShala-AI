# --- required ---
GEMINI_API_KEY=            # from Google AI Studio (free tier ok)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathshala
# --- models (verify current names in AI Studio; LiteLLM format provider/model) ---
LLM_MODEL=gemini/gemini-3-flash-preview
LLM_FAST_MODEL=gemini/gemini-3.5-flash-lite
LLM_VERIFY_MODEL=gemini/gemini-3.1-flash-lite
# --- embeddings: local bge-m3 (1024-d, matches db/schema.sql) ---
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# --- retrieval / behaviour ---
RETRIEVE_K=30
RERANK_K=5
RERANK=0
MIN_SCORE=0.45             # calibrated on 60 dev questions (T09)
VERIFY=1
REWRITE=1
CACHE=1
# --- optional observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
